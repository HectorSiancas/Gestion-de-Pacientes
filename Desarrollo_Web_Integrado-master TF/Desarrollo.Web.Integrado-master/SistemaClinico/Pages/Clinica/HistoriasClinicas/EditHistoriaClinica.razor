@page "/edit-historia-clinica"
@attribute [Authorize]

<PageTitle>Edit HistoriaClinica</PageTitle>

<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@errorVisible">Cannot save HistoriaClinica</RadzenAlert>
    <RadzenTemplateForm TItem="HistoriaClinicaCrearDTO" Data="@(historiaClinica)" Visible="@(historiaClinica != null)" Submit="@FormSubmit">
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="3">
                <RadzenLabel Text="Estado" Component="Estado" style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn SizeMD="9">
                <RadzenCheckBox @bind-Value="@(historiaClinica.Estado)" Name="Estado" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="3">
                <RadzenLabel Text="Fecha Apertura" Component="FechaApertura" style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn SizeMD="9">
                <RadzenDatePicker DateFormat="dd/MM/yyyy" style="display: block; width: 100%" @bind-Value="@(historiaClinica.FechaApertura)" Name="FechaApertura" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="3">
                <RadzenLabel Text="Paciente" Component="Paciente" style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn SizeMD="9">
                <RadzenDropDown Data="@(pacientesForIdPaciente)" TextProperty="ApMaterno" ValueProperty="IdPaciente" AllowClear=true
                                Placeholder="Elegir Paciente" style="display: block; width: 100%" @bind-Value="@(historiaClinica.IdPaciente)" Name="IdPaciente"
                                Count=@pacientesForIdPacienteCount LoadData=@pacientesForIdPacienteLoadData />
            </RadzenColumn>
        </RadzenRow>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Guardar" Variant="Variant.Flat" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancelar" Variant="Variant.Flat" Click="@CancelButtonClick" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenColumn>


@code {
    [Inject]
    protected IJSRuntime JSRuntime { get; set; }

    [Inject]
    protected NavigationManager NavigationManager { get; set; }

    [Inject]
    protected DialogService DialogService { get; set; }

    [Inject]
    protected TooltipService TooltipService { get; set; }

    [Inject]
    protected ContextMenuService ContextMenuService { get; set; }

    [Inject]
    protected NotificationService NotificationService { get; set; }
    // [Inject]
    // public dbService _dbService { get; set; }
    [Inject]
    public IService _service { get; set; }
    [Parameter]
    public int IdHistoriaClinica { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // historiaClinica = await _dbService.GetHistoriaClinicaByIdHistoriaClinica(idHistoriaClinica: IdHistoriaClinica);
        var httpResponse = await _service.Get<HistoriaClinicaCrearDTO>($"api/Historias-Clinicas/{IdHistoriaClinica}");
        if (httpResponse.Error)
        {
            NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = $"Error", Detail = await httpResponse.ObtenerMensajeError() });
        }
        else
        {
            historiaClinica = httpResponse.Response;
            historiaClinica.IdPaciente = httpResponse.Response.Paciente.IdPaciente;
        }
    }
    protected bool errorVisible;
    protected HistoriaClinicaCrearDTO historiaClinica;

    protected IEnumerable<Paciente> pacientesForIdPaciente;


    protected int pacientesForIdPacienteCount;
    protected Paciente pacientesForIdPacienteValue;
    protected async Task pacientesForIdPacienteLoadData(LoadDataArgs args)
    {
        try
        {
            // var result = await _dbService.GetPacientes(top: args.Top, skip: args.Skip, count: args.Top != null && args.Skip != null, filter: $"contains(ApMaterno, '{(!string.IsNullOrEmpty(args.Filter) ? args.Filter : "")}')", orderby: $"{args.OrderBy}");
            // pacientesForIdPaciente = result.Value.AsODataEnumerable();
            // pacientesForIdPacienteCount = result.Count;

            var httpResponse = await _service.Get<List<Paciente>>($"api/pacientes");
            if (httpResponse.Error)
            {
                NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = $"Error", Detail = await httpResponse.ObtenerMensajeError() });
            }
            else
            {
                pacientesForIdPaciente = httpResponse.Response.Skip(args.Skip ?? 0).Take(args.Top ?? 10);
                pacientesForIdPacienteCount = httpResponse.Response.Count;
            }

        }
        catch (System.Exception ex)
        {
            NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = $"Error", Detail = $"Unable to load Paciente" });
        }
    }
    protected async Task FormSubmit()
    {
        try
        {
            // await _dbService.UpdateHistoriaClinica(idHistoriaClinica: IdHistoriaClinica, historiaClinica);
            // DialogService.Close(historiaClinica);


            var paciente = await GetPaciente(historiaClinica.IdPaciente ?? 0);
            historiaClinica.Paciente = paciente;


            var httpResponse = await _service.Put($"api/Historias-Clinicas/{IdHistoriaClinica}", historiaClinica);
            if (httpResponse.Error)
            {
                NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = $"Error", Detail = await httpResponse.ObtenerMensajeError() });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Warning, Summary = $"Se modificó correctamente {IdHistoriaClinica}" });
                DialogService.Close(historiaClinica);
            }
        }
        catch (Exception ex)
        {
            errorVisible = true;
        }
    }

    protected async Task CancelButtonClick(MouseEventArgs args)
    {
        DialogService.Close(null);
    }

    async Task<Paciente> GetPaciente(int id)
    {
        try
        {
            var httpResponse = await _service.Get<Paciente>($"api/pacientes/{id}");
            if (!httpResponse.Error)
            {
                return httpResponse.Response;
            }

            return null;
        }
        catch (System.Exception ex)
        {
            return null;
        }
    }
}