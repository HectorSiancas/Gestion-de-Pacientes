@page "/edit-dia-semana"
@attribute [Authorize]

<PageTitle>Edit DiaSemana</PageTitle>

<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@errorVisible">Cannot save DiaSemana</RadzenAlert>
    <RadzenTemplateForm TItem="DiaSemanaCrearDTO" Data="@(diaSemana)" Visible="@(diaSemana != null)" Submit="@FormSubmit">
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="3">
                <RadzenLabel Text="Nombre Dia Semana" Component="NombreDiaSemana" style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn SizeMD="9">
                <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(diaSemana.NombreDiaSemana)" Name="NombreDiaSemana" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Guardar" Variant="Variant.Flat" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancelar" Variant="Variant.Flat" Click="@CancelButtonClick" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenColumn>

@code {

    [Inject]
    protected IJSRuntime JSRuntime { get; set; }

    [Inject]
    protected NavigationManager NavigationManager { get; set; }

    [Inject]
    protected DialogService DialogService { get; set; }

    [Inject]
    protected TooltipService TooltipService { get; set; }

    [Inject]
    protected ContextMenuService ContextMenuService { get; set; }

    [Inject]
    protected NotificationService NotificationService { get; set; }
    // [Inject]
    // public dbService _dbService { get; set; }
    [Inject]
    public IService _service { get; set; }

    [Parameter]
    public int IdDiaSemana { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // diaSemana = await _dbService.GetDiaSemanaByIdDiaSemana(idDiaSemana: IdDiaSemana);
        var httpResponse = await _service.Get<DiaSemanaCrearDTO>($"api/dias-semana/{IdDiaSemana}");
        if (httpResponse.Error)
        {
            NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = $"Error", Detail = await httpResponse.ObtenerMensajeError() });
        }
        else
        {
            diaSemana = httpResponse.Response;
            // especialidad.IdTipoEmpleado = httpResponse.Response.TipoEmpleado.IdTipoEmpleado;
        }
    }
    protected bool errorVisible;
    protected DiaSemanaCrearDTO diaSemana;

    protected async Task FormSubmit()
    {
        // try
        // {
        //     await _dbService.UpdateDiaSemana(idDiaSemana: IdDiaSemana, diaSemana);
        //     DialogService.Close(diaSemana);
        // }
        // catch (Exception ex)
        // {
        //     errorVisible = true;
        // }

        try
        {
            var httpResponse = await _service.Put($"api/dias-semana/{IdDiaSemana}", diaSemana);
            if (httpResponse.Error)
            {
                NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = $"Error", Detail = await httpResponse.ObtenerMensajeError() });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Warning, Summary = $"Se modificó correctamente {IdDiaSemana}" });
                DialogService.Close(diaSemana);
            }
        }
        catch (Exception ex)
        {
            errorVisible = true;
        }
    }

    protected async Task CancelButtonClick(MouseEventArgs args)
    {
        DialogService.Close(null);
    }
}