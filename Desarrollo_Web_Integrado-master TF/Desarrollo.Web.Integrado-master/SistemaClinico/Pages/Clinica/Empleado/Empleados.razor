@page "/empleados"
@attribute [Authorize]

<PageTitle>Empleados</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="Empleados" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Icon="add_circle_outline" Text="Agregar" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow>
        <RadzenColumn SizeMD=12>
            <RadzenDataGrid @ref="grid0" ColumnWidth="200px" AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[] { 5, 10, 20, 30 })
                            style="min-height: 150px" IsLoading=@isLoading
                            PagerHorizontalAlign="HorizontalAlign.Right" PageSizeText=" por página"
                            Data="@(empleados)" LoadData="@Grid0LoadData" Count="@count" TItem="Empleado" RowSelect="@EditRow">
                <Columns>
                    <RadzenDataGridColumn TItem="Empleado" Property="IdEmpleado" Title="Id Empleado">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Empleado" Property="ApMaterno" Title="Ap Materno">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Empleado" Property="ApPaterno" Title="Ap Paterno">
                    </RadzenDataGridColumn>
                    @*     <RadzenDataGridColumn TItem="Empleado" Property="Clave" Title="Clave">
                </RadzenDataGridColumn> *@
                    @*                <RadzenDataGridColumn TItem="Empleado" Property="Estado" Title="Estado">
                </RadzenDataGridColumn> *@
                    @*             <RadzenDataGridColumn TItem="Empleado" Property="Imagen" Title="Imagen">
                </RadzenDataGridColumn> *@
                    <RadzenDataGridColumn TItem="Empleado" Property="Nombres" Title="Nombres">
                    </RadzenDataGridColumn>
                    @*  <RadzenDataGridColumn TItem="Empleado" Title="Apellidos y Nombres">
                        <Template>
                            @context.ApPaterno @context.ApMaterno @context.Nombres
                        </Template>
                    </RadzenDataGridColumn> *@
                    <RadzenDataGridColumn TItem="Empleado" Property="NroDocumento" Title="Nro Documento">
                    </RadzenDataGridColumn>
                    @*             <RadzenDataGridColumn TItem="Empleado" Property="Usuario" Title="Usuario">
                </RadzenDataGridColumn> *@
                    <RadzenDataGridColumn TItem="Empleado" Property="TipoEmpleado.Descripcion" Title="Tipo Empleado">
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="Empleado" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                        <Template Context="empleado">

                            <RadzenButton ButtonStyle="ButtonStyle.Warning" Icon="edit" Size="ButtonSize.Medium"
                                          Shade="Shade.Lighter" Variant="Variant.Flat"
                                          Click=@(args => GridEditButtonClick(args, empleado)) @onclick:stopPropagation="true" />


                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="Empleado" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                        <Template Context="empleado">



                            <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                                          Shade="Shade.Lighter" Variant="Variant.Flat"
                                          Click=@(args => GridDeleteButtonClick(args, empleado)) @onclick:stopPropagation="true" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
                <LoadingTemplate>
                    <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                </LoadingTemplate>
                <PagingSummaryTemplate>
                    Página @context.CurrentPage de @context.NumberOfPages <b>(@context.TotalCount registros)</b>
                </PagingSummaryTemplate>
            </RadzenDataGrid>

        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@code {
    [Inject]
    protected IJSRuntime JSRuntime { get; set; }

    [Inject]
    protected NavigationManager NavigationManager { get; set; }

    [Inject]
    protected DialogService DialogService { get; set; }

    [Inject]
    protected TooltipService TooltipService { get; set; }

    [Inject]
    protected ContextMenuService ContextMenuService { get; set; }

    [Inject]
    protected NotificationService NotificationService { get; set; }

    [Inject]
    public dbService _dbService { get; set; }
    [Inject]
    public IService _service { get; set; }
    protected IEnumerable<Shared.Models.Clinica.Empleado> empleados;

    protected RadzenDataGrid<Shared.Models.Clinica.Empleado> grid0;
    protected int count;
    bool isLoading = false;
    protected async Task Grid0LoadData(LoadDataArgs args)
    {
        isLoading = true;
        try
        {
            //var result = await _dbService.GetEmpleados(filter: $"{args.Filter}", expand: "TipoEmpleado", orderby: $"{args.OrderBy}", top: args.Top, skip: args.Skip, count:args.Top != null && args.Skip != null);
            //empleados = result.Value.AsODataEnumerable();
            //count = result.Count;
            var httpResponse = await _service.Get<List<Shared.Models.Clinica.Empleado>>($"api/empleados");
            if (httpResponse.Error)
            {
                NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = $"Error", Detail = await httpResponse.ObtenerMensajeError() });
            }
            else
            {
                empleados = httpResponse.Response;
                count = httpResponse.Response.Count;
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = $"Error", Detail = $"Unable to load Empleados" });
        }
        finally
        {
            isLoading = false;
        }
    }

    protected async Task AddButtonClick(MouseEventArgs args)
    {
        await DialogService.OpenAsync<AddEmpleado>("Agregar Empleado", null);
        await grid0.Reload();
    }

    protected async Task EditRow(Shared.Models.Clinica.Empleado args)
    {
        await DialogService.OpenAsync<EditEmpleado>("Edit Empleado", new Dictionary<string, object> { { "IdEmpleado", args.IdEmpleado } });
        await grid0.Reload();
    }

    protected async Task GridEditButtonClick(MouseEventArgs args, Shared.Models.Clinica.Empleado empleado)
    {
        await DialogService.OpenAsync<EditEmpleado>("Edit Empleado", new Dictionary<string, object> { { "IdEmpleado", empleado.IdEmpleado } });
        await grid0.Reload();
    }

    protected async Task GridDeleteButtonClick(MouseEventArgs args, Shared.Models.Clinica.Empleado empleado)
    {
        try
        {
            if (await DialogService.Confirm("¿Está seguro de que desea eliminar este registro?", "Confirmar", new ConfirmOptions() { OkButtonText = "OK", CancelButtonText = "CANCELAR" }) == true)
            {
                //var deleteResult = await _dbService.DeleteEmpleado(idEmpleado:empleado.IdEmpleado);

                //if (deleteResult != null)
                //{
                //    await grid0.Reload();
                //}

                var httpResponse = await _service.Delete($"api/empleados/{empleado.IdEmpleado}");
                if (httpResponse.Error)
                {
                    NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = $"Error", Detail = await httpResponse.ObtenerMensajeError() });
                }
                else
                {
                    NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Success, Summary = $"Se eliminó correctamente" });
                    await grid0.Reload();
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"Error",
                Detail = $"No se puede eliminar Empleado"
            });
        }
    }
}