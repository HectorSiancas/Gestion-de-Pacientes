@page "/cita"
@attribute [Authorize]

<PageTitle>Cita</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="Citas" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Icon="add_circle_outline" Text="Nuevo" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow>
        <RadzenColumn SizeMD=12>
            <RadzenDataGrid @ref="grid0" ColumnWidth="200px" AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[] { 5, 10, 20, 30 })
                            Data="@(cita)" LoadData="@Grid0LoadData" Count="@count" TItem="Cita" RowSelect="@EditRow"
                            PagerHorizontalAlign="HorizontalAlign.Right" PageSizeText=" por página"
                            style="min-height: 150px" IsLoading=@isLoading>
                <Columns>
                    <RadzenDataGridColumn TItem="Cita" Property="IdCita" Title="Id Cita">
                    </RadzenDataGridColumn>
                    @* <RadzenDataGridColumn TItem="Cita" Property="Estado" Title="Estado">
                    </RadzenDataGridColumn> *@
                    <RadzenDataGridColumn TItem="Cita" Property="FechaReserva" Title="Fecha Reserva">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Cita" Property="Hora" Title="Hora">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Cita" Property="Observacion" Title="Observacion">
                    </RadzenDataGridColumn>
                    @* <RadzenDataGridColumn TItem="Cita" Property="MyHorarioAtencion" Title="Horario Atencion">
                    </RadzenDataGridColumn> *@
                    <RadzenDataGridColumn TItem="Cita" Title="Paciente">
                        <Template>
                            @context.HorarioAtencion.DiaSemana.NombreDiaSemana - @context.HorarioAtencion.HoraInicio.Hora1
                        </Template>
                    </RadzenDataGridColumn>
                    @* <RadzenDataGridColumn TItem="Cita" Property="Paciente.ApMaterno" Title="Paciente">
                    </RadzenDataGridColumn> *@
                    <RadzenDataGridColumn TItem="Cita" Title="Paciente">
                        <Template>
                            @context.Paciente.ApPaterno @context.Paciente.ApMaterno @context.Paciente.Nombres
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Cita" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                        <Template Context="citum">

                            <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                                          Shade="Shade.Lighter" Variant="Variant.Flat"
                                          Click=@(args => GridDeleteButtonClick(args, citum)) @onclick:stopPropagation="true" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
                <LoadingTemplate>
                    <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Size="ProgressBarCircularSize.Small" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                </LoadingTemplate>
                <PagingSummaryTemplate>
                    Página @context.CurrentPage de @context.NumberOfPages <b>(@context.TotalCount registros)</b>
                </PagingSummaryTemplate>
            </RadzenDataGrid>

        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@code {
    [Inject]
    protected IJSRuntime JSRuntime { get; set; }

    [Inject]
    protected NavigationManager NavigationManager { get; set; }

    [Inject]
    protected DialogService DialogService { get; set; }

    [Inject]
    protected TooltipService TooltipService { get; set; }

    [Inject]
    protected ContextMenuService ContextMenuService { get; set; }

    [Inject]
    protected NotificationService NotificationService { get; set; }

    [Inject]
    public dbService _dbService { get; set; }
    [Inject]
    public IService _service { get; set; }
    protected IEnumerable<Cita> cita;

    protected RadzenDataGrid<Cita> grid0;
    protected int count;
    bool isLoading = false;
    protected async Task Grid0LoadData(LoadDataArgs args)
    {
        isLoading = true;
        try
        {
            //var result = await _dbService.GetCita(filter: $"{args.Filter}", expand: "HorarioAtencion,Paciente", orderby: $"{args.OrderBy}", top: args.Top, skip: args.Skip, count:args.Top != null && args.Skip != null);
            //cita = result.Value.AsODataEnumerable();
            //count = result.Count;

            var httpResponse = await _service.Get<List<Cita>>($"api/Citas");
            if (httpResponse.Error)
            {
                NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = $"Error", Detail = await httpResponse.ObtenerMensajeError() });
            }
            else
            {
                cita = httpResponse.Response;
                count = httpResponse.Response.Count;
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = $"Error", Detail = $"Unable to load Cita" });
        }
        finally
        {
            isLoading = false;
        }
    }

    protected async Task AddButtonClick(MouseEventArgs args)
    {
        await DialogService.OpenAsync<AddCita>("Agregar Cita", null);
        await grid0.Reload();
    }

    protected async Task EditRow(Cita args)
    {
        await DialogService.OpenAsync<EditCita>("Edit Cita", new Dictionary<string, object> { { "IdCita", args.IdCita } });
        await grid0.Reload();
    }

    protected async Task GridDeleteButtonClick(MouseEventArgs args, Cita citum)
    {
        try
        {
            if (await DialogService.Confirm("Are you sure you want to delete this record?", "Confirmar", new ConfirmOptions() { OkButtonText = "OK", CancelButtonText = "CANCELAR" }) == true)
            {
                // var deleteResult = await _dbService.DeleteCitum(idCita: citum.IdCita);

                // if (deleteResult != null)
                // {
                //     await grid0.Reload();
                // }
                var httpResponse = await _service.Delete($"api/citas/{citum.IdCita}");
                if (httpResponse.Error)
                {
                    NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Error, Summary = $"Error", Detail = await httpResponse.ObtenerMensajeError() });
                }
                else
                {
                    NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Success, Summary = $"Se eliminó correctamente" });
                    await grid0.Reload();
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = $"Error",
                Detail = $"No se puede eliminar Cita"
            });
        }
    }
}