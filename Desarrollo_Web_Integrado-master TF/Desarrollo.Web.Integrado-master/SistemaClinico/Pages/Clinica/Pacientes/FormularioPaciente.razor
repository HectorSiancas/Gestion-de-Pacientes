        <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancelar" Variant="Variant.Flat" Click="@CancelButtonClick" />
    </RadzenStack>
</RadzenTemplateForm>


@code {
    [Parameter]
    public PacienteCreateDTO model { get; set; }

    [Parameter]
    public bool Modificar { get; set; }

    [Parameter]
    public EventCallback CancelButtonClick { get; set; }

    [Parameter]
    public EventCallback FormSubmit { get; set; }

    [Inject]
    public ReniecService _reniecService { get; set; }

    [Inject]
    protected NotificationService NotificationService { get; set; }


    void OnInvalidSubmit(FormInvalidSubmitEventArgs args)
    {

    }

    public string dniAnterior { get; set; }
    // protected override void OnInitialized()
    // {
    //     dniAnterior = model.NroDocumento;
    // }

    protected override void OnParametersSet()
    {
        // base.OnParametersSet();
        dniAnterior = model.NroDocumento;
    }
    async Task Onblur(object param)
    {
        var dniActual = model.NroDocumento?.Trim();
        if (dniActual == dniAnterior)        
            return;      

        dniAnterior = dniActual;
        var persona = await _reniecService.ConsumirServicioAsync(model.NroDocumento);
        if (persona != null)
        {
            model.Nombres = persona.Nombres;
            model.ApPaterno = persona.ApellidoPaterno;
            model.ApMaterno = persona.ApellidoMaterno;

            NotificationService.Notify(new NotificationMessage() { Severity = NotificationSeverity.Success, Summary = $"RENIEC OK" });
        }
    }

    private List<SexoOption> opcionesSexo = new()
    {
        new SexoOption { Text = "Masculino", Value = "M" },
        new SexoOption { Text = "Femenino", Value = "F" }
    };

    private class SexoOption
    {
        public string Text { get; set; }
        public string Value { get; set; }
    }
}