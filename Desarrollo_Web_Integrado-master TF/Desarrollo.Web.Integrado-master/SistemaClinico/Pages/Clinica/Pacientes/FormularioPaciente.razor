@using Shared.Enums
<RadzenTemplateForm TItem="PacienteCreateDTO" Data="@(model)" Visible="@(model != null)" Submit="@FormSubmit" InvalidSubmit=@OnInvalidSubmit>
    <RadzenRow style="margin-bottom: 1rem">
        <RadzenColumn SizeMD="3">
            <RadzenLabel Text="Nro Documento" Component="NroDocumento" style="width: 100%" />
