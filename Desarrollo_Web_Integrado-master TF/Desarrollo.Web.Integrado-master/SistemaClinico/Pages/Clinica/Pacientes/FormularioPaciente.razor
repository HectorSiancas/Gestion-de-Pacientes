        <RadzenColumn SizeMD="9">
            <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(model.NroDocumento)" Name="NroDocumento" @onblur="Onblur" />
            <RadzenDataAnnotationValidator Component="NroDocumento" Style="position: absolute" />
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow style="margin-bottom: 1rem">
        <RadzenColumn SizeMD="3">
            <RadzenLabel Text="Ap Paterno" Component="ApPaterno" style="width: 100%" />
        </RadzenColumn>
        <RadzenColumn SizeMD="9">
            <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(model.ApPaterno)" Name="ApPaterno" />
            <RadzenDataAnnotationValidator Component="ApPaterno" Style="position: absolute" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow style="margin-bottom: 1rem">
        <RadzenColumn SizeMD="3">
            <RadzenLabel Text="Ap Materno" Component="ApMaterno" style="width: 100%" />
        </RadzenColumn>
        <RadzenColumn SizeMD="9">
            <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(model.ApMaterno)" Name="ApMaterno" />
            <RadzenDataAnnotationValidator Component="ApMaterno" Style="position: absolute" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow style="margin-bottom: 1rem">
        <RadzenColumn SizeMD="3">
            <RadzenLabel Text="Nombres" Component="Nombres" style="width: 100%" />
        </RadzenColumn>
        <RadzenColumn SizeMD="9">
            <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(model.Nombres)" Name="Nombres" />
            <RadzenDataAnnotationValidator Component="Nombres" Style="position: absolute" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow style="margin-bottom: 1rem">
        <RadzenColumn SizeMD="3">
            <RadzenLabel Text="Correo" Component="Direccion" style="width: 100%" />
        </RadzenColumn>
        <RadzenColumn SizeMD="9">
            <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(model.Direccion)" Name="Direccion" />
            <RadzenDataAnnotationValidator Component="Direccion" Style="position: absolute" />
        </RadzenColumn>
    </RadzenRow>
