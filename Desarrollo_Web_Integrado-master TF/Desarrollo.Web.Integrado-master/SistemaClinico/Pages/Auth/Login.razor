    async void OnSubmit(Model model)
    {
        // console.Log($"Submit: {JsonSerializer.Serialize(model, new JsonSerializerOptions() { WriteIndented = true })}");


        if (model.Username == "admin" && model.Password == "admin")
        {
            await loginService.Login(new UserToken() { Token = model.Username });
            navigationManager.NavigateTo("");
        }
        else if (model.Username == "user" && model.Password == "user")
        {
            await loginService.Login(new UserToken() { Token = model.Username });
            navigationManager.NavigateTo("");
        }
        else
        {
            var notification = new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Resumen de errores",
                    Detail = "usuario o contraseña incorrecto",
                    Duration = 4000
                };

            NotificationService.Notify(notification);
        }
    }

